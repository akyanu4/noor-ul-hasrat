{
  "rules": {
    ".read": false,
    ".write": false,
    "collective": {
      "current": {
        ".read": true,
        "count": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 500"
        }
      }
    },
    "halqa": {
      "current": {
        ".read": true
      },
      "$week": {
        ".validate": "$week.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "rsvps": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['m', 't'])",
            "$other": {
              ".validate": false
            },
            "m": {
              ".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'offline')"
            },
            "t": {
              ".validate": "newData.val() == now"
            }
          }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.em != null",
        ".validate": "newData.child('email').val() === auth.token.em && newData.child('name').isString() && newData.child('name').val().length <= 60",
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "city": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "bayah": {
          "with": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        },
        "bayah_request": {
          "with": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "edited": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.isString() && newData.val() === 'sent'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "summaries": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.em != null",
        ".validate": "newData.child('score').isNumber()"
      }
    },
    "iman": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.em != null",
        "days": {
          "$day": {
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          }
        }
      }
    },
    "authlinks": {
      ".read": false,
      ".write": false
    },
    "bayah_ok": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "bayah_req": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "helpreq": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "teachers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "library_ok": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && auth.token.em != null && (root.child('teachers').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('at').isNumber() && newData.child('name').isString() && newData.child('name').val().length <= 100)"
      }
    },
    "library_notes": {
      ".read": "auth != null && (root.child('teachers').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      "$slug": {
        "$id": {
          ".write": "auth != null && auth.token.em != null && !data.exists() && (root.child('teachers').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.child('by').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 1000"
        }
      }
    },
    "rewards": {
      ".read": "auth != null && auth.token.em != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "helpmeta": {
      ".read": false,
      ".write": false
    },
    "stats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  }
}
