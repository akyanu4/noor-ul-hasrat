{
  "crons": [
    {
      "path": "/api/prayer-nudges",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/new-shorts",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/event-reminders",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/prayer-nudges.js": {
      "includeFiles": "js/{core,cities}.js",
      "maxDuration": 60
    },
    "api/new-shorts.js": {
      "includeFiles": "js/config.js",
      "maxDuration": 30
    },
    "api/s.js": {
      "includeFiles": "js/config.js",
      "maxDuration": 10
    },
    "api/event-reminders.js": {
      "includeFiles": "js/{faith,gatherings}.js",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    }
  ]
}