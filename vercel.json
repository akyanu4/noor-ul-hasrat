{
  "crons": [
    {
      "path": "/api/prayer-nudges",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/new-shorts",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/prayer-nudges.js": {
      "includeFiles": "js/{core,cities}.js",
      "maxDuration": 60
    },
    "api/new-shorts.js": {
      "includeFiles": "js/config.js",
      "maxDuration": 30
    }
  }
}
